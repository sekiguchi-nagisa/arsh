#!/usr/bin/env arsh

shctl set errraise

if $# != 1 {
    echo "[usage] $0 [output]" 1>&2
    exit 1
}

# let out = "../${$@[0]}"
let out = $1.startsWith("/") ? $1 : "../$1"
let work_dir = "version-temp"

test -d $work_dir || mkdir $work_dir

cd $work_dir

importenv UNICODE_VERSION : "UCD/latest"
echo try to download Unicode version file from https://www.unicode.org/Public/${UNICODE_VERSION}/ucd/ReadMe.txt
curl https://www.unicode.org/Public/${UNICODE_VERSION}/ucd/ReadMe.txt -o ./ReadMe.txt

## gen version string
var version : String?
cat ./ReadMe.txt | for l in $STDIN {
  var m = $/[vV]ersion ([0-9]+\.[0-9]+\.[0-9]+)/.match($l) ?? continue
  $version = $m.group(1)!
  break
}
assert $version : "cannot find version string in ReadMe.txt"

cat << EOF > $out
/* Auto-generated by scripts/unicode/$(basename $0)  */

#define UNICODE_VERSION_STR "${$version!}"

EOF

echo code generation success
