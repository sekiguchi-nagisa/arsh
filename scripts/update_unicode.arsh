#!/usr/bin/env arsh

shctl set errraise

[<CLI(toplevel:$true)>]
type _Param() {
    [<Option(help: "specify Unicode version (defauilt: latest)")>]
    var version = "latest"
}

let param = new _Param()
try { $param.parse($@); } catch e { echo 1>&2 ${$e.message()}; exit ${$e.status()}; }
assert $param.version == "latest" || $param.version =~ $/^\d+\.\d+\.\d+$/ : "invalid version string: ${param.version}"

let src = "$SCRIPT_DIR/../src".realpath()
let test = "$SCRIPT_DIR/../test"

mkdir -p unicode-temp && cd unicode-temp \
    && rm -r ./*  # force clear old files

## prepare
exportenv GUNISET_UNICODE_VERSION = $param.version
call $SCRIPT_DIR/unicode/guniset_helper.arsh

exportenv UNICODE_VERSION = $param.version == "latest" ? "UCD/latest" : $param.version

## generate unicode tables
echo try to update $src/misc/unicode_version.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_unicode_version.ds $src/misc/unicode_version.in

echo try to update $src/misc/unicode_width.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_unicode_width_table.ds $src/misc/unicode_width.in

echo try to update $src/unicode/grapheme_break_property.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_grapheme_break_property.ds $src/unicode/grapheme_break_property.in

echo try to update $src/unicode/word_break_property.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_word_break_property.ds $src/unicode/word_break_property.in

echo try to update $src/unicode/simple_case_fold.in and $src/unicode/full_case_fold.in and $test/unicode/case_fold.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_case_fold.arsh  \
    --simple $src/unicode/simple_case_fold.in --full $src/unicode/full_case_fold.in --test $test/unicode/case_fold.in

echo try to update $src/unicode/emoji_variation.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_emoji_variation.arsh $src/unicode/emoji_variation.in

echo try to update $src/unicode/ucp_general_category.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_category_table.arsh --header=$src/unicode/ucp_general_category_def.in $src/unicode/ucp_general_category.in

echo try to update $src/unicode/ucp_script.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_script_table.arsh --header=$src/unicode/ucp_script_def.in $src/unicode/ucp_script.in

echo try to update $src/unicode/ucp_lone.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_lone_property_table.arsh --header=$src/unicode/ucp_lone_def.in $src/unicode/ucp_lone.in

let tools = "$SCRIPT_DIR/../tools".realpath()
echo try to update $tools/emoji/emoji_seq.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_emoji_seq_table.arsh $tools/emoji/emoji_seq.in


## for test case
echo try to update $test/unicode/grapheme_break_test.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_grapheme_break_test.ds $test/unicode/grapheme_break_test.in

echo try to update $test/unicode/word_break_test.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_word_break_test.ds $test/unicode/word_break_test.in

echo try to update $test/unicode/ucp_property_test.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_property_test.arsh --type=cpp $test/unicode/ucp_property_test.in

echo try to update $test/regex/charset_matcher_test.in
call $BIN_NAME $SCRIPT_DIR/unicode/gen_charset_matcher_test.arsh $test/regex/charset_matcher_test.in

echo try to update $test/exec/cases/generated
call $BIN_NAME $SCRIPT_DIR/unicode/gen_regex_unicode_set_test.arsh $test/exec/cases/generated