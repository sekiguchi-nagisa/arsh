
source $SCRIPT_DIR/../syntax/test_helper.arsh

# \p{Basic_Emoji}
assert diff <(redump -m '⚡' '\p{Basic_Emoji}' 'v') <(<<'EOF'
input: `⚡'
(offset=0, size=3)
EOF
)

assert diff <(redump -m '🪾' '\p{Basic_Emoji}' 'v') <(<<'EOF'
input: `🪾'
(offset=0, size=4)
EOF
)

assert diff <(redump -m '↕️' '[\p{Basic_Emoji}]' 'v') <(<<'EOF'
input: `↕️'
(offset=0, size=6)
EOF
)

assert diff <(redump -m '↕' '[\p{Basic_Emoji}]' 'v') <(<<'EOF'
input: `↕'
failed
EOF
)

assert diff <(redump -m '❤️' '[\p{Basic_Emoji}]' 'v') <(<<'EOF'
input: `❤️'
(offset=0, size=6)
EOF
)

assert diff <(redump -m '🕷️' '[\p{Basic_Emoji}]' 'v') <(<<'EOF'
input: `🕷️'
(offset=0, size=7)
EOF
)

assert diff <(redump -m '🕷' '[\p{Basic_Emoji}]' 'v') <(<<'EOF'
input: `🕷'
failed
EOF
)

assert diff <(redump -m 'Q' '\p{Basic_Emoji}' 'v') <(<<'EOF'
input: `Q'
failed
EOF
)

