
source $SCRIPT_DIR/../syntax/test_helper.arsh

# (?<=\p{Basic_Emoji})
assert diff <(redump -m '⚡' '(?<=\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `⚡'
(offset=3, size=0)
EOF
)

assert diff <(redump -m '🪾' '(?<=\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `🪾'
(offset=4, size=0)
EOF
)

assert diff <(redump -m '↕️' '(?<=\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `↕️'
(offset=6, size=0)
EOF
)

assert diff <(redump -m '↕' '(?<=[\p{Basic_Emoji}])' 'v') <(<<'EOF'
input: `↕'
failed
EOF
)

assert diff <(redump -m '↕' '(?<![\p{Basic_Emoji}])' 'v') <(<<'EOF'
input: `↕'
(offset=0, size=0)
EOF
)

assert diff <(redump -m '❤️' '(?<=[\p{Basic_Emoji}])' 'v') <(<<'EOF'
input: `❤️'
(offset=6, size=0)
EOF
)

assert diff <(redump -m '🕷️' '(?<=[\p{Basic_Emoji}])' 'iv') <(<<'EOF'
input: `🕷️'
(offset=7, size=0)
EOF
)

assert diff <(redump -m '🕷' '(?<=\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `🕷'
failed
EOF
)

assert diff <(redump -m 'Q' '(?<=\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `Q'
failed
EOF
)

assert diff <(redump -m 'Q' '(?<!\p{Basic_Emoji})' 'v') <(<<'EOF'
input: `Q'
(offset=0, size=0)
EOF
)

