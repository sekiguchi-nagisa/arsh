# a[a-z]{2,4}?
assert diff <(redump -d 'a[a-z]{2,4}?' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 1
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Char(codePoint=U+0061:a)
   5: BeginLoop(loopIndex=0, greedy=false, min=2, max=4, outer=28)
  19: CharSet(matcherIndex=0, invert=false)
  23: EndLoop(target=5)
  28: Match
prefilter:
  data:
\x61
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
  0: AsciiSet
{ 0x0061, 0x007A },
EOF
)

# <.+?>
assert diff <(redump -d '<.+?>' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 1
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Char(codePoint=U+003C:<)
   5: BeginLoop(loopIndex=0, greedy=false, min=1, max=4294967295, outer=25)
  19: AnyExceptNL
  20: EndLoop(target=5)
  25: Char(codePoint=U+003E:>)
  30: Match
prefilter:
  data:
\x3C
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

