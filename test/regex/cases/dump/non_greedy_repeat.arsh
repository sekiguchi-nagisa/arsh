  14: ResetCaptures(firstIndex=1, lastIndex=1)
  19: BeginCapture(captureIndex=1)
  22: Char(codePoint=U+0061:a)
  27: EndCapture(captureIndex=1)
  30: EndLoop(target=0)
  35: Match
prefilter:
  data:
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

