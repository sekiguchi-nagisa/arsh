
source $SCRIPT_DIR/../syntax/test_helper.arsh

# .|.|
assert diff <(redump -d '.|.|' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Alt(second=11)
   5: AnyExceptNL
   6: Jump(target=17)
  11: Alt(second=17)
  16: AnyExceptNL
  17: Match
prefilter:
  data:
  maxPrevCodePoints: 0
matchers:
EOF
)

# .|||..|||
assert diff <(redump -d '.|||..|||' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Alt(second=11)
   5: AnyExceptNL
   6: Jump(target=28)
  11: Alt(second=21)
  16: Jump(target=28)
  21: Alt(second=28)
  26: AnyExceptNL
  27: AnyExceptNL
  28: Match
prefilter:
  data:
  maxPrevCodePoints: 0
matchers:
EOF
)

# A|(?:B|.)
assert diff <(redump -d 'A|(?:B|.)' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Alt(second=15)
   5: Char(codePoint=U+0041:A)
  10: Jump(target=31)
  15: Alt(second=30)
  20: Char(codePoint=U+0042:B)
  25: Jump(target=31)
  30: AnyExceptNL
  31: Match
prefilter:
  data:
  maxPrevCodePoints: 0
matchers:
EOF
)


# A|(?:B|C)
assert diff <(redump -d 'A|(?:B|C)' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: CharSet(matcherIndex=0, invert=false)
  4: Match
prefilter:
  data:
0x41, 0x42, 0x43,
  maxPrevCodePoints: 0
matchers:
  0: AsciiSet
{ 0x0041, 0x0043 },
EOF
)
