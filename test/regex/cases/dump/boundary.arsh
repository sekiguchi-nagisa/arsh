# \b(?m-i:\B@$)
assert diff <(redump -d '\b(?m-i:\B@$)' 'i') <(<<'EOF'
flag: (mode = , modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: IWord(invert=false)
   2: Word(invert=true)
   4: Char(codePoint=U+0040:@)
   9: End(multiline=true)
  11: Match
prefilter:
  data:
\x40
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

# (?<=\b(?m-i:\B$))
assert diff <(redump -d '(?<=\b(?m-i:\B$))' 'i') <(<<'EOF'
flag: (mode = , modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: BeginLookAround(negate=false, target=12)
   6: End(multiline=true)
   8: Word(invert=true)
  10: IWord(invert=false)
  12: EndLookAround
  13: Match
prefilter:
  data:
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)