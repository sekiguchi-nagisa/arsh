
source $SCRIPT_DIR/../syntax/test_helper.arsh

# ^$($|^)
assert diff <(redump -d '^$($|^)' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 0
captureGroupCount: 1
namedCaptureGroups: []
instructions:
   0: Start(multiline=false)
   2: End(multiline=false)
   4: BeginCapture(captureIndex=1)
   7: Alt(second=19)
  12: End(multiline=false)
  14: Jump(target=21)
  19: Start(multiline=false)
  21: EndCapture(captureIndex=1)
  24: Match
prefilter:
  data: start
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

# ^(?m:^$)$
assert diff <(redump -d '^(?m:^$)$' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: Start(multiline=false)
  2: Start(multiline=true)
  4: End(multiline=true)
  6: End(multiline=false)
  8: Match
prefilter:
  data: start
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

# ^(?-m:^$)$
assert diff <(redump -d '^(?-m:^$)$' 'ums') <(<<'EOF'
flag: (mode = u, modifier = ms)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: Start(multiline=true)
  2: Start(multiline=false)
  4: End(multiline=false)
  6: End(multiline=true)
  8: Match
prefilter:
  data: line_start
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

# ^w|(^.)
assert diff <(redump -d '^w|(^.)' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 1
namedCaptureGroups: []
instructions:
   0: Alt(second=17)
   5: Start(multiline=false)
   7: Char(codePoint=U+0077:w)
  12: Jump(target=26)
  17: BeginCapture(captureIndex=1)
  20: Start(multiline=false)
  22: AnyExceptNL
  23: EndCapture(captureIndex=1)
  26: Match
prefilter:
  data: start
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

assert diff <(redump -d '^w|(^.)' 'm') <(<<'EOF'
flag: (mode = , modifier = m)
loopCount: 0
captureGroupCount: 1
namedCaptureGroups: []
