
source $SCRIPT_DIR/../syntax/test_helper.arsh

# 1.{0,0}
assert diff <(redump -d '1.{0,0}' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 1
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: Char(codePoint=U+0031:1)
  5: Match
firstSet:
matchers:
EOF
)

# 1.{0,0}2{1}3
assert diff <(redump -d '1.{0,0}2{1}3' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 2
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: String(index=0)
  3: Match
firstSet:
matchers:
  0: String
\x31\x32\x33
EOF
)