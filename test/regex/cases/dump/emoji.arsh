
source $SCRIPT_DIR/../syntax/test_helper.arsh

# \p{RGI_Emoji_ZWJ_Sequence}
assert diff <(redump -d '\p{RGI_Emoji_ZWJ_Sequence}' 'v') <(<<'EOF'
flag: (mode = v, modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: PrepareRadix
  1: RadixOrEmoji(emoji=RGI_Emoji_ZWJ_Sequence, hasRadix=false, index=0, nextOffset=0)
  7: Match
firstSet:
  0xE2, 0xF0,
matchers:
EOF
)

assert diff <(redump -d '\p{RGI_Emoji_ZWJ_Sequence}' 'vi') <(<<'EOF'
flag: (mode = v, modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: PrepareRadix
  1: RadixOrEmoji(emoji=RGI_Emoji_ZWJ_Sequence|case-ignore, hasRadix=false, index=0, nextOffset=0)
  7: Match
firstSet:
  0xE2, 0xF0,
matchers:
EOF
)

