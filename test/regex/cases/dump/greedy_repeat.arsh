
source $SCRIPT_DIR/../syntax/test_helper.arsh

# a*
assert diff <(redump -d 'a*' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: CharLoop(greedy=true, direction=true, min=0, max=4294967295)
   9: Char(codePoint=U+0061:a)
  14: Match
prefilter:
  data:
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

