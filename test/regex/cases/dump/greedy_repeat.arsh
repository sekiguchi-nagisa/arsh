# ^(a+)\1*,\1+$
assert diff <(redump -d '^(a+)\1*,\1+$' 'i') <(<<'EOF'
flag: (mode = , modifier = i)
loopCount: 2
captureGroupCount: 1
namedCaptureGroups: []
instructions:
   0: Start(multiline=false)
   2: BeginCapture(captureIndex=1)
   5: CharLoop(greedy=true, direction=true, min=1, max=4294967295)
  14: IChar(codePoint=U+0061:a)
  19: EndCapture(captureIndex=1)
  22: BeginLoop(loopIndex=0, greedy=true, min=0, max=4294967295, outer=45)
  36: IBackRef(index=1, named=false)
  40: EndLoop(target=22)
  45: Char(codePoint=U+002C:,)
  50: BeginLoop(loopIndex=1, greedy=true, min=1, max=4294967295, outer=73)
  64: IBackRef(index=1, named=false)
  68: EndLoop(target=50)
  73: End(multiline=false)
  75: Match
prefilter:
  data: start
  minPrevCodePoints: 0
  maxPrevCodePoints: 0
matchers:
EOF
)

