# 1.{0,0}
assert diff <(redump -d '1.{0,0}' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 1
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: Char(codePoint=U+0031:1)
  5: Match
firstSet:
  0x31,
matchers:
EOF
)

# 1.{0,0}2{1}3
assert diff <(redump -d '1.{0,0}2{1}3' 'u') <(<<'EOF'
flag: (mode = u, modifier = )
loopCount: 2
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: String(index=0)
  3: Match
firstSet:
  0x31,
matchers:
  0: String
\x31\x32\x33
EOF
)

# [\w]{001}
assert diff <(redump -d '[\w]{001}' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 1
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: CharSet(matcherIndex=0, invert=false)
  4: Match
firstSet:
  0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46,
  0x47, 0x48, 0x49, 0x4A, 0x4B, 0x4C, 0x4D, 0x4E, 0x4F, 0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56,
  0x57, 0x58, 0x59, 0x5A, 0x5F, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6A, 0x6B,
  0x6C, 0x6D, 0x6E, 0x6F, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7A,
matchers:
  0: AsciiSet
{ 0x0030, 0x0039 },
{ 0x0041, 0x005A },
{ 0x005F, 0x005F },
{ 0x0061, 0x007A },
EOF
)

