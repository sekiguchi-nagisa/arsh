
source $SCRIPT_DIR/../syntax/test_helper.arsh

# 1|2
assert diff <(redump -d '1|2' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: CharSet(matcherIndex=0, invert=false)
  4: Match
firstSet:
  0x31, 0x32,
matchers:
  0: AsciiSet
{ 0x0031, 0x0032 },
EOF
)

# 1|11|2
assert diff <(redump -d '1|11|2' '') <(<<'EOF'  # not optimize
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Alt(second=15)
   5: Char(codePoint=U+0031:1)
  10: Jump(target=33)
  15: Alt(second=28)
  20: String(index=0)
  23: Jump(target=33)
  28: Char(codePoint=U+0032:2)
  33: Match
firstSet:
  0x31, 0x32,
matchers:
  0: String
\x31\x31
EOF
)

# 11|1|2
assert diff <(redump -d '11|1|2' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: PrepareRadix
   1: RadixOrEmoji(emoji=, hasRadix=true, index=0, nextOffset=4)
   7: CharSet(matcherIndex=1, invert=false)
  11: Match
firstSet:
  0x31, 0x32,
matchers:
  0: RadixTree
property: 0x01, string: \x31\x31
  1: AsciiSet
{ 0x0031, 0x0032 },
EOF
)

# (11|1|2||)
assert diff <(redump -d '(11|1|2||)' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 1
namedCaptureGroups: []
instructions:
   0: BeginCapture(captureIndex=1)
   3: Alt(second=19)
   8: PrepareRadix
   9: RadixOrEmoji(emoji=, hasRadix=true, index=0, nextOffset=4)
  15: CharSet(matcherIndex=1, invert=false)
  19: EndCapture(captureIndex=1)
  22: Match
firstSet:
matchers:
  0: RadixTree
property: 0x01, string: \x31\x31
  1: AsciiSet
{ 0x0031, 0x0032 },
EOF
)

# 11|1|2||3
assert diff <(redump -d '11|1|2||3' '') <(<<'EOF'   # not optimize
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: Alt(second=13)
   5: String(index=0)
   8: Jump(target=58)
  13: Alt(second=28)
  18: Char(codePoint=U+0031:1)
  23: Jump(target=58)
  28: Alt(second=43)
  33: Char(codePoint=U+0032:2)
  38: Jump(target=58)
  43: Alt(second=53)
  48: Jump(target=58)
  53: Char(codePoint=U+0033:3)
  58: Match
firstSet:
matchers:
  0: String
\x31\x31
EOF
)

# (?<=12|1|2).
assert diff <(redump -d '(?<=12|1|2).' 'i') <(<<'EOF'   # not optimize
flag: (mode = , modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: BeginLookAround(negate=false, target=41)
   6: Alt(second=19)
  11: LBString(index=0)
  14: Jump(target=41)
  19: Alt(second=35)
  24: LBChar(ignoreCase=false, codePoint=U+0031:1)
  30: Jump(target=41)
  35: LBChar(ignoreCase=false, codePoint=U+0032:2)
  41: EndLookAround
  42: AnyExceptNL
  43: Match
firstSet:
matchers:
  0: String
\x31\x32
EOF
)

# (?<!11|1|23|あい|)
assert diff <(redump -d '(?<!11|1|23|あい|)' '') <(<<'EOF'    # not optimize
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: BeginLookAround(negate=true, target=61)
   6: Alt(second=19)
  11: LBString(index=0)
  14: Jump(target=61)
  19: Alt(second=35)
  24: LBChar(ignoreCase=false, codePoint=U+0031:1)
  30: Jump(target=61)
  35: Alt(second=48)
  40: LBString(index=1)
  43: Jump(target=61)
  48: Alt(second=61)
  53: LBString(index=2)
  56: Jump(target=61)
  61: EndLookAround
  62: Match
firstSet:
matchers:
  0: String
\x31\x31
  1: String
\x32\x33
  2: String
\xE3\x81\x82\xE3\x81\x84
EOF
)

# Tom|Sawyer|Huckleberry|Finn|A|a
assert diff <(redump -d 'Tom|Sawyer|Huckleberry|Finn|A|a' '') <(<<'EOF'
flag: (mode = , modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: PrepareRadix
   1: RadixOrEmoji(emoji=, hasRadix=true, index=0, nextOffset=4)
   7: CharSet(matcherIndex=1, invert=false)
  11: Match
firstSet:
  0x41, 0x46, 0x48, 0x53, 0x54, 0x61,
matchers:
  0: RadixTree
property: 0x01, string: \x46\x69\x6E\x6E
property: 0x01, string: \x48\x75\x63\x6B\x6C\x65\x62\x65\x72\x72\x79
property: 0x01, string: \x53\x61\x77\x79\x65\x72
property: 0x01, string: \x54\x6F\x6D
  1: AsciiSet
{ 0x0041, 0x0041 },
{ 0x0061, 0x0061 },
EOF
)

assert diff <(redump -d 'Tom|Sawyer|Huckleberry|Finn|A|a' 'i') <(<<'EOF'
flag: (mode = , modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: PrepareRadix
   1: RadixOrEmoji(emoji=case-ignore, hasRadix=true, index=0, nextOffset=5)
   7: IChar(codePoint=U+0061:a)
  12: Match
firstSet:
  0x41, 0x46, 0x48, 0x53, 0x54, 0x61, 0x66, 0x68, 0x73, 0x74, 0xC5,
matchers:
  0: RadixTree
property: 0x01, string: \x66\x69\x6E\x6E
property: 0x01, string: \x68\x75\x63\x6B\x6C\x65\x62\x65\x72\x72\x79
property: 0x01, string: \x73\x61\x77\x79\x65\x72
property: 0x01, string: \x74\x6F\x6D
EOF
)