# [\p{ASCII}&&\W&&\D]
assert diff <(redump -d '[\p{ASCII}&&\W&&\D]' 'v') <(<<'EOF'
flag: (mode = v, modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: CharSet(matcherIndex=0, invert=false)
  4: Match
firstSet:
  0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
  0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F,
  0x3A, 0x3B, 0x3C, 0x3D, 0x3E, 0x3F, 0x40, 0x5B, 0x5C, 0x5D, 0x5E, 0x60, 0x7B, 0x7C, 0x7D, 0x7E,
  0x7F,
matchers:
  0: CodePointSet(owned)
{ 0x0000, 0x002F },
{ 0x003A, 0x0040 },
{ 0x005B, 0x005E },
{ 0x0060, 0x0060 },
{ 0x007B, 0x007F },
EOF
)

# (?<=[\d&&[\p{ASCII}&&\W&&\D]])
assert diff <(redump -d '(?<=[\d&&[\p{ASCII}&&\W&&\D]])' 'v') <(<<'EOF'
flag: (mode = v, modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: BeginLookAround(negate=false, target=11)
   6: LBCharSet(matcherIndex=0, invert=false, ignoreCase=false)
  11: EndLookAround
  12: Match
firstSet:
matchers:
  0: AsciiSet
EOF
)

assert diff <(redump -d '(?<=[\d&&[\p{ASCII}&&\W&&\D]])' 'iv') <(<<'EOF'
flag: (mode = v, modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
   0: BeginLookAround(negate=false, target=11)
   6: LBCharSet(matcherIndex=0, invert=false, ignoreCase=true)
  11: EndLookAround
  12: Match
firstSet:
matchers:
  0: AsciiSet
EOF
)

