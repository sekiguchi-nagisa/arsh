
source $SCRIPT_DIR/../syntax/test_helper.arsh

# [\w&&\d]
assert diff <(redump -d '[\w&&\d]' 'v') <(<<'EOF'
flag: (mode = v, modifier = )
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: CharSet(matcherIndex=0, invert=false)
  4: Match
firstSet:
  0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39,
matchers:
  0: AsciiSet
{ 0x0030, 0x0039 },
EOF
)

assert diff <(redump -d '[\w&&\d]' 'vi') <(<<'EOF'
flag: (mode = v, modifier = i)
loopCount: 0
captureGroupCount: 0
namedCaptureGroups: []
instructions:
  0: ICharSet(matcherIndex=0, invert=false)
  4: Match
firstSet:
  0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39,
matchers:
  0: AsciiSet
{ 0x0030, 0x0039 },
EOF
)

