#!/usr/bin/env arsh

# Benchmark the arsh regex engine with rust-leipzig/regex-performance.
#
# Besides arsh, the following engines can be added as comparison targets:
#   * std::regex (--std-regex)
#   * SRELL      (--srell)       header-only, fetched automatically if needed
#   * QuickJS    (--quickjs)     libregexp, fetched automatically if needed
#   * Hermes     (--hermes)      fetched and built automatically if needed
#   * Boost.Regex (--boost)      fetched and built automatically if needed
#   * PCRE2      (--pcre2)       fetched and built automatically if needed
#   * Node.js    (--nodejs)      uses the installed `node` executable
#
# Steps:
#   1. fetch rust-leipzig/regex-performance (pinned commit) into the work directory,
#   2. apply tools/regex-bench/regex-performance.patch and copy the adapters,
#   3. build the arsh regex static libraries (and the requested comparison engines),
#   4. build `regex_perf`,
#   5. run it against the bundled 3200.txt.
#
# Each engine reports its time, score, match count and heap memory usage (the size of the
# compiled regex instance and the peak extra memory allocated while scanning the input).
#
# Usage:
#   arsh tools/regex-bench/run.arsh                              # arsh only
#   arsh tools/regex-bench/run.arsh --std-regex --srell --boost  # compare with others
#   arsh tools/regex-bench/run.arsh --repeat 3 --output results.csv
#   arsh tools/regex-bench/run.arsh --cxx clang++                # build with clang++
#   arsh tools/regex-bench/run.arsh --keep                       # keep the work directory
#   arsh tools/regex-bench/run.arsh --prepare                    # only fetch/build the engines
#   arsh tools/regex-bench/run.arsh --target arsh --target srell # only the specified engines
#   arsh tools/regex-bench/run.arsh --pattern 'Twain'            # only the specified patterns
#   arsh tools/regex-bench/run.arsh --perf profile               # profile the run with perf

shctl set errraise

# the engine names known to the benchmark harness (see the engines table of
# rust-leipzig/regex-performance). --target selects a subset of them.
let TARGETS = ['arsh', 'cppstd', 'srell', 'quickjs', 'hermes', 'boost', 'pcre', 'pcre-jit', 'nodejs']

let REPO_URL = "https://github.com/rust-leipzig/regex-performance.git"
let REPO_REF = "52cb0538eca86ad549f6895dbfa9a2f71bc82244" # pinned commit (2022-10-13)
let HERMES_REF = "ade4a2b20246340d4309cf62be51f9652dcde279" # pinned commit (2026-10-02)
let SRELL_URL = "https://github.com/upa-url/srell.git"
let QUICKJS_URL = "https://github.com/quickjs-ng/quickjs.git"
let HERMES_URL = "https://github.com/facebook/hermes.git"
let PCRE2_URL = "https://github.com/PCRE2Project/pcre2"
let PCRE2_VERSION = "pcre2-10.49" # pinned release (its tarball bundles the sljit JIT dependency)
let BOOST_ARCHIVE = "https://archives.boost.io/release"

# The name of the C compiler that belongs to the specified C++ compiler
# (e.g. clang++-18 -> clang-18, g++-12 -> gcc-12).
function _cCompilerName(cxx: String) : String? {
    let name = $cxx.basename()
    if $name.startsWith("clang++") {
        return "clang${$name.slice("clang++".size())}"
    } elif $name.startsWith("g++") {
        return "gcc${$name.slice("g++".size())}"
    } elif $name == "c++" {
        return "cc"
    }
    return $none
}

# Resolve the C compiler of the specified C++ compiler, or $none if there is none.
function _cCompiler(cxx: String) : String? {
    if let name = $_cCompilerName($cxx) {
        if $cxx.contains("/") {
            let path = "${$cxx.dirname()}/$name"
            if (test -x $path) {
                return $path
            }
        } elif (command -v $name &>> /dev/null) {
            return $name
        }
    }
    return $none
}

# A suffix for the build directories, so builds with different compilers do not share a
# CMake cache. Empty when no compiler is specified (keeps the default layout).
function _compilerTag(cxx: String?) : String {
    if let c = $cxx {
        let name = $_cCompilerName($c) ?? $c.basename()
        return "-${$name.replace("+", "")}"
    }
    return ""
}

# Check that the specified C++ compiler is usable and report the missing one otherwise. The C
# compiler of the same toolchain is optional (see _cCompiler) and is not required here.
function _checkCompiler(cxx: String) {
    if $cxx == "" {
        echo 1>&2 "C++ compiler must not be empty"
        exit 1
    }
    if $cxx.contains("/") {
        if !(test -x $cxx) {
            echo 1>&2 "C++ compiler not found: $cxx"
            exit 1
        }
    } elif !(command -v $cxx &>> /dev/null) {
        echo 1>&2 "C++ compiler not found: $cxx"
        exit 1
    }
}

# The CMake arguments selecting the specified C++ compiler (and its C compiler, if known).
function _compilerArgs(cxx: String?) : [String] {
    var args : [String]
    if let c = $cxx {
        $args.add("-DCMAKE_CXX_COMPILER=$c")
        if let cc = $_cCompiler($c) {
            $args.add("-DCMAKE_C_COMPILER=$cc")
        }
    }
    return $args
}

# Check that `perf` is usable for recording a profile and report the reason otherwise.
function _checkPerf(callGraph: Bool) {
    if !(command -v perf &>> /dev/null) {
        echo 1>&2 "perf not found (install linux-tools / perf)"
        exit 1
    }
    if $callGraph {
        var paranoid : Int?
        if (test -r /proc/sys/kernel/perf_event_paranoid) {
            $paranoid = "$(cat /proc/sys/kernel/perf_event_paranoid)".toInt()
        }
        if let level = $paranoid {
            if $level > 1 {
                echo 1>&2 "perf call graphs need kernel.perf_event_paranoid <= 1 (current: ${level})"
                exit 1
            }
        }
    }
}

# Run `bin args` under `perf record`, then write a text report next to the data file.
# `base` is a path prefix: the profile goes to <base>.data and the report to <base>.report.
function _runWithPerf(base: String, bin: String, args: [String], callGraph: Bool) {
    let dataFile = "${base}.data"
    let reportFile = "${base}.report"
    let dir = $dataFile.dirname()
    test -d $dir || mkdir -p $dir || exit $?

    var perfArgs : [String]
    $perfArgs.add("record")
    if $callGraph {
        $perfArgs.add("-g")
    }
    # the frequency is raised so a short benchmark still yields enough samples
    $perfArgs.add("-F")
    $perfArgs.add("997")
    $perfArgs.add("-o")
    $perfArgs.add($dataFile)
    $perfArgs.add("--")
    $perfArgs.add($bin)
    $perfArgs.addAll($args)

    echo "run: perf ${$perfArgs.join(' ')}"
    call perf $perfArgs || exit $?

    # the report is derived from the recorded data, so a failure here is not fatal.
    # a plain `>' redirection is used because perf writes the symbol table differently when
    # its output is not a regular file (the `with' modifier yields an empty table here)
    if !(perf report -i $dataFile --stdio --percent-limit 0.5 > $reportFile 2>&1) {
        echo 1>&2 "failed to write $reportFile"
        return
    }
    echo "profile: $dataFile"
    echo "report: $reportFile"
}

[<CLI(toplevel: $true, verbose:$true)>]
type _Param() {
    [<Option(help: "number of repetitions (default: 5)")>]
    var repeat : Int?

    [<Option(placeholder: "FILE", help: "write measured data into CSV file")>]
    var output : String?

    [<Option(placeholder: "FILE", help: "benchmark input file (default: bundled 3200.txt)")>]
    var input : String?

    [<Option(placeholder: "NAME", help: "benchmark only the specified engine (repeatable)")>]
    var target : [String]

    [<Option(placeholder: "PATTERN", help: "benchmark only the specified pattern (repeatable)")>]
    var pattern : [String]

    [<Option(placeholder: "BASE", help: "profile the run with perf record and write BASE.data / BASE.report")>]
    var perf : String?

    [<Flag(help: "record call graphs too (perf record -g, needs perf_event_paranoid <= 1)")>]
    var perfCallGraph = $false

    [<Option(help: "arsh build type (default: Release)")>]
    var build = "Release"

    [<Option(placeholder: "CXX", help: "C++ compiler used to build arsh and the benchmark")>]
    var cxx : String?

    [<Option(placeholder: "DIR", help: "working directory (default: .regex-bench)")>]
    var work = ".regex-bench"

    [<Flag(help: "keep the fetched work directory")>]
    var keep = $false

    [<Flag(help: "only fetch and patch, do not build or run")>]
    var setup = $false

    [<Flag(help: "only fetch and build the comparison engines, then stop")>]
    var prepare = $false

    [<Flag(help: "add std::regex as a comparison target")>]
    var stdRegex = $false

    [<Flag(help: "add SRELL as a comparison target")>]
    var srell = $false

    [<Option(placeholder: "DIR", help: "use an existing SRELL source directory")>]
    var srellDir : String?

    [<Flag(help: "add QuickJS (libregexp) as a comparison target")>]
    var quickjs = $false

    [<Option(placeholder: "DIR", help: "use an existing QuickJS source directory")>]
    var quickjsDir : String?

    [<Flag(help: "add Hermes as a comparison target")>]
    var hermes = $false

    [<Option(placeholder: "DIR", help: "use an existing Hermes source directory")>]
    var hermesDir : String?

    [<Option(placeholder: "DIR", help: "use an existing Hermes build directory")>]
    var hermesBuildDir : String?

    [<Flag(help: "add Boost.Regex as a comparison target")>]
    var boost = $false

    [<Option(placeholder: "DIR", help: "use an existing Boost installation")>]
    var boostDir : String?

    [<Option(placeholder: "VER", help: "Boost version to fetch (default: latest)")>]
    var boostVersion : String?

    [<Flag(help: "add PCRE2 (interpreted and JIT) as comparison targets")>]
    var pcre2 = $false

    [<Option(placeholder: "DIR", help: "use an existing PCRE2 build directory")>]
    var pcre2Dir : String?

    [<Flag(help: "add Node.js as a comparison target")>]
    var nodejs = $false

    [<Option(placeholder: "FILE", help: "Node.js executable (default: node from PATH)")>]
    var nodejsBin : String?
}

function _latestBoostVersion() : String {
    return "$(curl -sL $BOOST_ARCHIVE/ | grep -oE '[0-9]+[.][0-9]+[.][0-9]+' | sort -V | tail -n 1)"
}

function _fetchBoost(work: String, version: String) : String {
    let prefix = "$work/boost"
    if (test -e "$prefix/include/boost/regex.hpp") {
        return $prefix
    }
    let shortVer = $version.replace(".", "_")
    let tarball = "$work/boost_${shortVer}.tar.bz2"
    echo "fetch Boost $version"
    curl -sL -o $tarball "$BOOST_ARCHIVE/$version/source/boost_${shortVer}.tar.bz2" || exit $?
    let srcDir = "$work/boost_${shortVer}"
    test -d $srcDir && rm -rf $srcDir
    mkdir -p $srcDir || exit $?
    tar xf $tarball -C $srcDir --strip-components=1 || exit $?
    cd $srcDir || exit $?
    ./bootstrap.sh --with-libraries=regex --prefix=$prefix > /dev/null 2>&1 || exit $?
    ./b2 -j8 --with-regex release install > /dev/null 2>&1 || exit $?
    cd $work || exit $?
    test -e "$prefix/include/boost/regex.hpp" || { echo 1>&2 "boost build failed"; exit 1; }
    return $prefix
}

function _fetchSrell(work: String) : String {
    let src = "$work/srell"
    if !(test -e "$src/srell-src/single-header/srell.hpp") {
        echo "fetch $SRELL_URL"
        git clone $SRELL_URL $src || exit $?
    }
    # single-header variant bundles the Unicode data tables
    return "$src/srell-src/single-header"
}

function _fetchQuickjs(work: String) : String {
    let src = "$work/quickjs"
    if !(test -e "$src/libregexp.c") {
        echo "fetch $QUICKJS_URL"
        git clone --depth 1 $QUICKJS_URL $src || exit $?
    }
    return $src
}

function _fetchHermes(work: String) : String {
    let src = "$work/hermes"
    if !(test -e "$src/include/hermes/Regex/Regex.h") {
        echo "fetch $HERMES_URL"
        git clone --depth 1 $HERMES_URL $src || exit $?
        cd $src || exit $?
        git fetch --depth 1 origin $HERMES_REF > /dev/null 2>&1 || exit $?
        git checkout --force FETCH_HEAD > /dev/null 2>&1 || exit $?
        cd $work || exit $?
    }
    return $src
}

function _buildHermes(work: String, hermesSrc: String) : String {
    let buildDir = "$work/hermes-build"
    if !(test -e "$buildDir/lib/Regex/libhermesRegex.a") {
        mkdir -p $buildDir || exit $?
        # only the regex engine and the support libraries it needs are required
        cmake -S $hermesSrc -B $buildDir -DCMAKE_BUILD_TYPE=Release || exit $?
        cmake --build $buildDir --target hermesRegex hermesSupport -j || exit $?
    }
    test -e "$buildDir/lib/Regex/libhermesRegex.a" || { echo 1>&2 "hermes build failed"; exit 1; }
    return $buildDir.realpath()
}

function _fetchPcre2(work: String) : String {
    let src = "$work/pcre2"
    if !(test -e "$src/CMakeLists.txt") {
        echo "fetch PCRE2 $PCRE2_VERSION"
        # use the release asset tarball (not the git archive): it bundles the sljit sources that
        # the JIT needs, which are otherwise a git submodule.
        test -e $src && rm -rf $src
        mkdir -p $src || exit $?
        curl -sL "$PCRE2_URL/releases/download/$PCRE2_VERSION/$PCRE2_VERSION.tar.gz" | tar xz -C $src --strip-components=1 || exit $?
    }
    return $src
}

function _buildPcre2(work: String, pcre2Src: String) : String {
    let buildDir = "$work/pcre2-build"
    # PCRE2 builds the static library without position independent code unless asked to. Such an
    # archive cannot be linked into a PIE executable, which is what the compilers default to on
    # most distributions (clang++ always does), so a cache without PCRE2_STATIC_PIC must be
    # discarded and rebuilt.
    if (test -e "$buildDir/CMakeCache.txt") && !(grep -q "PCRE2_STATIC_PIC:BOOL=ON" "$buildDir/CMakeCache.txt" &>> /dev/null) {
        rm -rf $buildDir
    }
    if !(test -e "$buildDir/libpcre2-8.a") {
        mkdir -p $buildDir || exit $?
        # only the 8-bit library is needed; the JIT must be enabled explicitly and the archive
        # must be position independent so that it can be linked into a PIE executable
        cmake -S $pcre2Src -B $buildDir -DCMAKE_BUILD_TYPE=Release -DPCRE2_SUPPORT_JIT=ON \
              -DPCRE2_STATIC_PIC=ON \
              -DPCRE2_BUILD_PCRE2_16=OFF -DPCRE2_BUILD_PCRE2_32=OFF \
              -DPCRE2_BUILD_TESTS=OFF -DPCRE2_BUILD_PCRE2GREP=OFF || exit $?
        cmake --build $buildDir --target pcre2-8-static -j || exit $?
    }
    test -e "$buildDir/libpcre2-8.a" || { echo 1>&2 "pcre2 build failed"; exit 1; }
    return $buildDir.realpath()
}

function _fetchAndPatch(root: String, work: String) {
    let src = "$work/regex-performance"
    if !(test -d $src) {
        echo "fetch $REPO_URL"
        git clone $REPO_URL $src || exit $?
    }
    cd $src || exit $?
    git checkout --force $REPO_REF > /dev/null 2>&1 || exit $?
    git reset --hard $REPO_REF > /dev/null 2>&1 || exit $?
    git clean -fdx > /dev/null 2>&1 || $true

    let bench = "${root}/tools/regex-bench"
    cp $bench/memory_tracker.h $src/src/memory_tracker.h || exit $?
    cp $bench/memory_tracker.cpp $src/src/memory_tracker.cpp || exit $?
    cp $bench/arsh.cpp $src/src/arsh.cpp || exit $?
    cp $bench/arsh.cmake $src/src/arsh.cmake || exit $?
    cp $bench/srell.cpp $src/src/srell.cpp || exit $?
    cp $bench/srell.cmake $src/src/srell.cmake || exit $?
    cp $bench/boost.cmake $src/src/boost.cmake || exit $?
    cp $bench/quickjs.c $src/src/quickjs.c || exit $?
    cp $bench/quickjs.cmake $src/src/quickjs.cmake || exit $?
    cp $bench/hermes.cpp $src/src/hermes.cpp || exit $?
    cp $bench/hermes.cmake $src/src/hermes.cmake || exit $?
    cp $bench/pcre2.c $src/src/pcre2.c || exit $?
    cp $bench/pcre2.cmake $src/src/pcre2.cmake || exit $?
    cp $bench/nodejs.cpp $src/src/nodejs.cpp || exit $?
    cp $bench/nodejs.cmake $src/src/nodejs.cmake || exit $?
    if !(git apply $bench/regex-performance.patch) {
        echo 1>&2 "failed to apply regex-performance.patch"
        exit 1
    }
    echo "patched: $src"
}

function _buildArsh(root: String, work: String, buildType: String, cxx: String?) : String {
    let buildDir = "$work/arsh-build${$_compilerTag($cxx)}"
    mkdir -p $buildDir || exit $?
    let compilerArgs = $_compilerArgs($cxx)
    cmake -S $root -B $buildDir -DCMAKE_BUILD_TYPE=$buildType $compilerArgs || exit $?
    cmake --build $buildDir --target regex -j || exit $?
    return $buildDir.realpath()
}

function _buildBench(root: String, work: String, arshBuild: String, srellSrc: String?, quickjsSrc: String?, hermesSrc: String?, hermesBuild: String?, boostPrefix: String?, pcre2Build: String?, nodejsBin: String?, stdRegex: Bool, cxx: String?) : String {
    let src = "$work/regex-performance"
    let buildDir = "$work/regex-perf-build${$_compilerTag($cxx)}"
    mkdir -p $buildDir || exit $?
    cd $src || exit $?
    let srcDir = $root.realpath()
    var common : [String]
    $common.add("-DCMAKE_POLICY_VERSION_MINIMUM=3.5")
    $common.add("-DCMAKE_BUILD_TYPE=Release")
    $common.addAll($_compilerArgs($cxx))
    $common.add("-DINCLUDE_ARSH=local")
    $common.add("-DARSH_SOURCE_DIR=$srcDir")
    $common.add("-DARSH_BUILD_DIR=$arshBuild")
    $common.add("-DINCLUDE_RUST=disabled")
    $common.add("-DINCLUDE_HYPERSCAN=disabled")
    $common.add("-DINCLUDE_ONIGURUMA=disabled")
    $common.add("-DINCLUDE_TRE=disabled")
    $common.add("-DINCLUDE_CTRE=disabled")
    $common.add("-DINCLUDE_RE2=disabled")
    $common.add("-DINCLUDE_YARA=disabled")
    if let dir = $srellSrc {
        $common.add("-DINCLUDE_SRELL=local")
        $common.add("-DSRELL_SOURCE_DIR=$dir")
    } else {
        $common.add("-DINCLUDE_SRELL=disabled")
    }
    if let dir = $quickjsSrc {
        $common.add("-DINCLUDE_QUICKJS=local")
        $common.add("-DQUICKJS_SOURCE_DIR=$dir")
    } else {
        $common.add("-DINCLUDE_QUICKJS=disabled")
    }
    if let src = $hermesSrc {
        if let dir = $hermesBuild {
            $common.add("-DINCLUDE_HERMES=local")
            $common.add("-DHERMES_SOURCE_DIR=$src")
            $common.add("-DHERMES_BUILD_DIR=$dir")
        } else {
            $common.add("-DINCLUDE_HERMES=disabled")
        }
    } else {
        $common.add("-DINCLUDE_HERMES=disabled")
    }
    if let prefix = $boostPrefix {
        $common.add("-DINCLUDE_BOOST=system")
        $common.add("-DBOOST_ROOT=$prefix")
    } else {
        $common.add("-DINCLUDE_BOOST=disabled")
    }
    if $stdRegex {
        $common.add("-DINCLUDE_CPPSTD=system")
    } else {
        $common.add("-DINCLUDE_CPPSTD=disabled")
    }
    if let dir = $pcre2Build {
        $common.add("-DINCLUDE_PCRE2=local")
        $common.add("-DPCRE2_BUILD_DIR=$dir")
    } else {
        $common.add("-DINCLUDE_PCRE2=disabled")
    }
    if let bin = $nodejsBin {
        $common.add("-DINCLUDE_NODEJS=local")
        $common.add("-DNODEJS_EXECUTABLE=$bin")
    } else {
        $common.add("-DINCLUDE_NODEJS=disabled")
    }
    cmake -S $src -B $buildDir $common || exit $?
    cmake --build $buildDir --target regex_perf -j || exit $?
    return "$buildDir/src/regex_perf"
}

function run() for _Param {
    if $this.work == "" {
        echo 1>&2 "working directory must not be empty"
        exit 1
    }
    if let o = $this.output {
        $o == "" && { echo 1>&2 "output path must not be empty"; exit 1; }
    }
    # --target selects both the engines to build and the engines to benchmark, so an unknown
    # name is rejected before anything is fetched or built
    for t in $this.target {
        if !$TARGETS.contains($t) {
            echo 1>&2 "unknown target: ${t} (available: ${$TARGETS.join(', ')})"
            exit 1
        }
    }
    if $this.pattern.contains('') {
        echo 1>&2 "pattern must not be empty"
        exit 1
    }
    var perfBase : String?
    if let p = $this.perf {
        if $p == "" {
            echo 1>&2 "--perf path must not be empty"
            exit 1
        }
        # resolve the profile path before anything changes the cwd, and strip the suffix so
        # `--perf foo.data` does not produce `foo.data.data`
        let base = $p.endsWith(".data") ? $p.slice(0, $p.size() - ".data".size()) : $p
        $perfBase = $base.startsWith('/') ? $base : "$PWD/$base"
        $_checkPerf($this.perfCallGraph)
    } elif $this.perfCallGraph {
        echo 1>&2 "--perf-call-graph requires --perf"
        exit 1
    }
    let root = "$SCRIPT_DIR/../..".realpath()
    let workDir = $this.work
    mkdir -p $workDir || exit $?
    let work = $workDir.realpath()

    # resolve the compiler before anything builds; the build directories of different
    # compilers are kept apart (see _compilerTag)
    var cxxOpt : String?
    if let c = $this.cxx {
        $_checkCompiler($c)
        $cxxOpt = $c
    }

    # resolve the user-specified directories before _fetchAndPatch changes the cwd
    var srellDirOpt : String?
    if let d = $this.srellDir {
        $srellDirOpt = $d.realpath()
    }
    var quickjsDirOpt : String?
    if let d = $this.quickjsDir {
        $quickjsDirOpt = $d.realpath()
    }
    var hermesDirOpt : String?
    if let d = $this.hermesDir {
        $hermesDirOpt = $d.realpath()
    }
    var hermesBuildDirOpt : String?
    if let d = $this.hermesBuildDir {
        $hermesBuildDirOpt = $d.realpath()
    }
    var boostDirOpt : String?
    if let d = $this.boostDir {
        $boostDirOpt = $d.realpath()
    }
    var pcre2DirOpt : String?
    if let d = $this.pcre2Dir {
        $pcre2DirOpt = $d.realpath()
    }
    var nodejsBinOpt : String?
    if let d = $this.nodejsBin {
        $nodejsBinOpt = $d.realpath()
    }

    $_fetchAndPatch($root, $work)
    if $this.setup {
        echo "setup done: $work/regex-performance"
        return
    }

    # --prepare only fetches/builds the comparison engines and reports their locations.
    # It is used by build_rematch.arsh, which points the rematch build at them.
    if $this.prepare {
        let srellSrc = $srellDirOpt ?? $_fetchSrell($work)
        let quickjsSrc = $quickjsDirOpt ?? $_fetchQuickjs($work)
        let hermesSrc = $hermesDirOpt ?? $_fetchHermes($work)
        let hermesBuild = $hermesBuildDirOpt ?? $_buildHermes($work, $hermesSrc)
        echo "srell: $srellSrc"
        echo "quickjs: $quickjsSrc"
        echo "hermes: $hermesSrc"
        echo "hermes-build: $hermesBuild"
        echo "prepare done: $work"
        return
    }

    # a target named with --target also enables its engine, so the engine is fetched/built
    # before the benchmark measures it
    let srellWanted = $this.srell || $this.target.contains('srell')
    let quickjsWanted = $this.quickjs || $this.target.contains('quickjs')
    let hermesWanted = $this.hermes || $this.target.contains('hermes')
    let boostWanted = $this.boost || $this.target.contains('boost')
    let pcre2Wanted = $this.pcre2 || $this.target.contains('pcre') || $this.target.contains('pcre-jit')
    let nodejsWanted = $this.nodejs || $this.target.contains('nodejs')
    let stdRegexWanted = $this.stdRegex || $this.target.contains('cppstd')

    var srellSrc : String?
    if let d = $srellDirOpt {
        $srellSrc = $d
    } elif $srellWanted {
        $srellSrc = $_fetchSrell($work)
    }

    var quickjsSrc : String?
    if let d = $quickjsDirOpt {
        $quickjsSrc = $d
    } elif $quickjsWanted {
        $quickjsSrc = $_fetchQuickjs($work)
    }

    var boostPrefix : String?
    if let d = $boostDirOpt {
        $boostPrefix = $d
    } elif $boostWanted {
        let version = $this.boostVersion ?? $_latestBoostVersion()
        $boostPrefix = $_fetchBoost($work, $version)
    }

    var hermesSrc : String?
    if let d = $hermesDirOpt {
        $hermesSrc = $d
    } elif $hermesWanted {
        $hermesSrc = $_fetchHermes($work)
    }

    var hermesBuild : String?
    if let d = $hermesBuildDirOpt {
        $hermesBuild = $d
    } elif let d = $hermesSrc {
        $hermesBuild = $_buildHermes($work, $d)
    }

    var pcre2Build : String?
    if let d = $pcre2DirOpt {
        $pcre2Build = $d
    } elif $pcre2Wanted {
        $pcre2Build = $_buildPcre2($work, $_fetchPcre2($work))
    }

    var nodejsBin : String?
    if let d = $nodejsBinOpt {
        $nodejsBin = $d
    } elif $nodejsWanted {
        $nodejsBin = "node" # resolved on PATH by CMake (find_program)
    }

    let arshBuild = $_buildArsh($root, $work, $this.build, $cxxOpt)
    let bin = $_buildBench($root, $work, $arshBuild, $srellSrc, $quickjsSrc, $hermesSrc, $hermesBuild, $boostPrefix, $pcre2Build, $nodejsBin, $stdRegexWanted, $cxxOpt)

    var args : [String]
    if let r = $this.repeat {
        $args.add("-n")
        $args.add("$r")
    }
    if let o = $this.output {
        $args.add("-o")
        $args.add($o)
    }
    # without --target/--pattern the harness measures every engine compiled into it with the
    # built-in pattern set
    for t in $this.target {
        $args.add("-e")
        $args.add($t)
    }
    for p in $this.pattern {
        $args.add("-p")
        $args.add($p)
    }
    $args.add("-f")
    $args.add($this.input ?? "$work/regex-performance/3200.txt")

    if let base = $perfBase {
        $_runWithPerf($base, $bin, $args, $this.perfCallGraph)
    } else {
        echo "run: $bin $args"
        call $bin $args || exit $?
    }

    if !$this.keep {
        rm -rf $work || $true
    }
}

let param = new _Param()
try {
    $param.parse($@)
} catch e {
    echo 1>&2 ${$e.message()}
    exit ${$e.status()}
}
$param.run()
