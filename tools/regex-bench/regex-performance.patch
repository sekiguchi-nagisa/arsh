--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1,13 +1,57 @@
-add_subdirectory(rust)
+set(INCLUDE_RUST "local" CACHE STRING "Use rust regex crate. disabled/other.")
